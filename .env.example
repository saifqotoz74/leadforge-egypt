# ==============================================================================
# LEADFORGE EGYPT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy to .env for local development.
# NEVER commit real production secrets to source control.

# ------------------------------------------------------------------------------
# 1. Application
# ------------------------------------------------------------------------------
NODE_ENV="development"
APP_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"
DEBUG="false"
ALLOW_PRODUCTION_SEED="false"
CRON_SECRET="generate-32-chars-random-secret-for-vercel-cron"

# ------------------------------------------------------------------------------
# 2. Database
# ------------------------------------------------------------------------------
# In local dev/test, USE_EXTERNAL_PG="false" uses embedded PGlite at ./.pgdata.
# In staging/production, USE_EXTERNAL_PG MUST be "true" with a managed PostgreSQL URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadforge_egypt?schema=public"
USE_EXTERNAL_PG="false"
PGLITE_DATA_DIR="./.pgdata"
DB_POOL_MAX="20"
DB_CONNECT_TIMEOUT_MS="5000"

# ------------------------------------------------------------------------------
# 3. Authentication
# ------------------------------------------------------------------------------
# Must be at least 32 characters of cryptographic randomness in production.
AUTH_SECRET="leadforge-egypt-local-dev-secret-change-in-production-32chars"
SESSION_TTL_SECONDS="604800"

# ------------------------------------------------------------------------------
# 4. Payment & Webhooks
# ------------------------------------------------------------------------------
PAYMENT_ENABLED="false"
PAYMENT_MODE="SANDBOX"
PAYMENT_PROVIDER_NAME="PAYMOB"
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 5. Email / Notifications
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="CONSOLE"
EMAIL_FROM="notifications@leadforge.eg"
EMAIL_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"

# ------------------------------------------------------------------------------
# 6. Storage
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="DISABLED"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# 7. Collectors & Lead Supply
# ------------------------------------------------------------------------------
COLLECTORS_ENABLED="false"
COLLECTOR_ALLOWED_SOURCES="manual,csv"
COLLECTOR_MAX_RECORDS_PER_RUN="250"

# ------------------------------------------------------------------------------
# 8. Observability & Alerting
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
MONITORING_ENABLED="true"
ALERT_WEBHOOK_URL=""
APP_VERSION="1.0.0"
