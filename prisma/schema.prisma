  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           Plan     @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model ImportJob {
  id                     String             @id @default(cuid())
  userId                 String
  sourceId               String?
  sourceName             String
  fileName               String?
  collectorVersion       String             @default("manual-v1")
  contractVersion        String             @default("INGESTION_CONTRACT_V1")
  triggerType            String             @default("MANUAL")
  status                 String             @default("COMPLETED")
  startedAt              DateTime           @default(now())
  completedAt            DateTime?
  durationMs             Int                @default(0)
  totalRows              Int                @default(0)
  discoveredCount        Int                @default(0)
  fetchedCount           Int                @default(0)
  normalizedCount        Int                @default(0)
  validCount             Int                @default(0)
  insertedCount          Int                @default(0)
  updatedCount           Int                @default(0)
  duplicateCount         Int                @default(0)
  possibleDuplicateCount Int                @default(0)
  conflictCount          Int                @default(0)
  invalidCount           Int                @default(0)
  failedCount            Int                @default(0)
  skippedCount           Int                @default(0)
  saleableCount          Int                @default(0)
  retryCount             Int                @default(0)
  deadLetterCount        Int                @default(0)
  errorCode              String?
  errorSummary           String?
  checkpoint             Json?
  configurationSnapshot  Json?
  cancelRequested        Boolean            @default(false)
  cancelledAt            DateTime?
  cancelledBy            String?
  idempotencyKey         String?
  backfillStartDate      DateTime?
  backfillEndDate        DateTime?
  acquisitionCostEgp     Float?
  summary                Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @default(now()) @updatedAt

  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  source                 LeadSource?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  records                ImportRecord[]
  deadLetterRecords      DeadLetterRecord[]

  @@index([userId])
  @@index([sourceId])
  @@index([status])
  @@index([sourceId, status])
  @@index([idempotencyKey])
  @@index([createdAt])
}

model ImportRecord {
  id                 String             @id @default(cuid())
  importJobId        String
  rowNumber          Int
  sourceId           String?
  sourceType         SourceType         @default(MANUAL)
  externalId         String?
  collectorVersion   String             @default("manual-v1")
  rawData            Json
  normalizedData     Json?
  checksum           String?
  status             ImportRecordStatus
  lifecycleStage     String             @default("PROCESSED")
  errorCode          String?
  errorMessage       String?
  retryCount         Int                @default(0)
  leadId             String?
  sourceRecordId     String?
  fetchedAt          DateTime           @default(now())
  retentionExpiresAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  importJob          ImportJob          @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  lead               Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([importJobId])
  @@index([status])
  @@index([externalId])
  @@index([sourceType, externalId])
  @@index([checksum])
  @@index([leadId])
}

model DeadLetterRecord {
  id                 String      @id @default(cuid())
  sourceId           String?
  sourceName         String
  sourceType         SourceType  @default(MANUAL)
  externalId         String?
  importJobId        String?
  importRecordId     String?
  collectorVersion   String      @default("manual-v1")
  failureReason      String
  errorCode          String      @default("RETRY_EXHAUSTED")
  lastError          String
  retryCount         Int         @default(0)
  maxRetries         Int         @default(3)
  status             String      @default("DEAD_LETTER")
  rawPayload         Json?
  normalizedPayload  Json?
  checksum           String?
  resolvedAt         DateTime?
  resolvedBy         String?
  resolutionNotes    String?
  resolvedLeadId     String?
  retentionExpiresAt DateTime?
  firstFailedAt      DateTime    @default(now())
  lastFailedAt       DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt

  source             LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  importJob          ImportJob?  @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([sourceId])
  @@index([sourceType, externalId])
  @@index([importJobId])
  @@index([errorCode])
  @@index([createdAt])
}

enum MatchingRuleCategory {
  SERVICE
  NICHE
  LOCATION
  BUDGET
  LEAD_TYPE
  QUALITY
  FRESHNESS
  PREFERENCE
  PERFORMANCE
}

enum ServiceMatchMode {
  ALL_REQUIRED
  ANY_REQUIRED
}

enum UnknownDataPolicy {
  ALLOW_WITH_PENALTY
  REQUIRE_VERIFICATION
  FAIL
}

enum RequiresVerificationMatchPolicy {
  EXCLUDE
  VERIFIED_DEVELOPERS_ONLY
  INCLUDE_WITH_WARNING
}

model MatchingRule {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  nameEn      String               @default("")
  description String?
  category    MatchingRuleCategory @default(SERVICE)
  ruleGroup   String?
  points      Int                  @default(10)
  priority    Int                  @default(0)
  enabled     Boolean              @default(true)
  version     String               @default("v1")
  condition   Json                 @default("{}")
  usageCount  Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([enabled])
  @@index([category])
  @@index([ruleGroup])
  @@index([version])
  @@index([priority])
}

model MatchingConfig {
  id                         String                          @id @default("default")
  currentVersion             String                          @default("v1")
  versionNumber              Int                             @default(1)
  serviceMatchMode           ServiceMatchMode                @default(ALL_REQUIRED)
  unknownLocationPolicy      UnknownDataPolicy               @default(FAIL)
  unknownBudgetPolicy        UnknownDataPolicy               @default(ALLOW_WITH_PENALTY)
  requiresVerificationPolicy RequiresVerificationMatchPolicy @default(EXCLUDE)
  budgetHardRequirement      Boolean                         @default(true)
  requireActiveSubscription  Boolean                         @default(true)
  requireDeveloperVerified   Boolean                         @default(false)
  minMatchStrength           Int                             @default(0)
  maxMatchStrength           Int                             @default(100)
  unknownLocationPenalty     Int                             @default(10)
  unknownBudgetPenalty       Int                             @default(5)
  updatedAt                  DateTime                        @updatedAt
}

model MatchSnapshot {
  id               String            @id @default(cuid())
  leadId           String
  developerId      String
  profileId        String?
  matchVersion     String            @default("v1")
  eligible         Boolean           @default(false)
  rank             Int?
  matchStrength    Int               @default(0)
  rawMatchPoints   Int               @default(0)
  opportunityScore Int               @default(0)
  qualityScore     Int               @default(0)
  freshness        String            @default("FRESH")
  matchedCriteria  Json              @default("[]")
  failedCriteria   Json              @default("[]")
  hardFailures     Json              @default("[]")
  warnings         Json              @default("[]")
  explanation      Json?
  isStale          Boolean           @default(false)
  calculatedAt     DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  lead             Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  developerProfile DeveloperProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([leadId, developerId, matchVersion])
  @@index([leadId, eligible, matchStrength])
  @@index([developerId, eligible, matchStrength])
  @@index([matchVersion])
  @@index([calculatedAt])
  @@index([isStale])
}

enum ClaimStatus {
  PENDING
  ACTIVE
  REFUNDED
  EXPIRED
  CANCELLED
  FAILED
}

enum CreditTransactionType {
  PURCHASE
  CLAIM
  REFUND
  BONUS
  ADMIN_ADJUSTMENT
  EXPIRATION
  CORRECTION
}

model DeveloperCreditAccount {
  id                String              @id @default(cuid())
  developerId       String              @unique
  balance           Int                 @default(0)
  reservedBalance   Int                 @default(0)
  lifetimePurchased Int                 @default(0)
  lifetimeBonus     Int                 @default(0)
  lifetimeSpent     Int                 @default(0)
  lifetimeRefunded  Int                 @default(0)
  lifetimeExpired   Int                 @default(0)
  totalGranted      Int                 @default(0)
  totalSpent        Int                 @default(0)
  totalRefunded     Int                 @default(0)
  version           Int                 @default(1)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user              User                @relation(fields: [developerId], references: [id], onDelete: Cascade)
  transactions      CreditTransaction[]

  @@index([developerId])
  @@index([balance])
}

model CreditTransaction {
  id             String                 @id @default(cuid())
  accountId      String
  developerId    String
  type           CreditTransactionType
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  referenceType  String?
  referenceId    String?
  claimId        String?
  leadId         String?
  idempotencyKey String?
  reason         String                 @default("")
  actorId        String?
  performedById  String?
  metadata       Json?
  createdAt      DateTime               @default(now())

  account        DeveloperCreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
