  @@index([developerId])
  @@index([accountId])
  @@index([type])
  @@index([claimId])
  @@index([leadId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@index([developerId, createdAt])
}

model CreditPricingConfig {
  id                            String   @id @default("default")
  version                       String   @default("v1")
  sharedLeadBaseCost            Int      @default(5)
  exclusiveLeadBaseCost         Int      @default(25)
  sharedBaseCost                Int      @default(5)
  exclusiveBaseCost             Int      @default(25)
  highOpportunityCostBonus      Int      @default(0)
  highOpportunityThreshold      Int      @default(80)
  highQualityCostBonus          Int      @default(0)
  highQualityThreshold          Int      @default(85)
  highBudgetCostBonus           Int      @default(0)
  highBudgetThresholdEgp        Int      @default(500000)
  freshLeadBonus                Int      @default(0)
  minCreditCost                 Int      @default(1)
  maxCreditCost                 Int      @default(100)
  defaultClaimExpirationDays    Int      @default(90)
  autoRefundOnInvalidLead       Boolean  @default(true)
  autoRefundOnDuplicateLead     Boolean  @default(true)
  autoRefundOnClosedWithinHours Int      @default(24)
  updatedAt                     DateTime @updatedAt
}

enum RuleReviewType {
  SCORING
  MATCHING
  QUALITY
}

enum RuleReviewStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  DEFERRED
}

model RuleReviewCandidate {
  id                   String           @id @default(cuid())
  ruleType             RuleReviewType
  ruleKey              String
  ruleName             String           @default("")
  ruleVersion          String           @default("v1")
  metric               String
  metricVersion        String           @default("WIN_RATE_V1")
  baselineValue        Float
  observedValue        Float
  absoluteDifference   Float            @default(0)
  relativeDifference   Float?
  sampleSize           Int
  minimumSampleSize    Int              @default(50)
  triggeredNumerator   Int              @default(0)
  triggeredDenominator Int              @default(0)
  baselineNumerator    Int              @default(0)
  baselineDenominator  Int              @default(0)
  evidenceWindow       String
  evidenceDetails      Json?
  recommendation       String?
  status               RuleReviewStatus @default(OPEN)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  reviewedAt           DateTime?
  reviewedBy           String?
  decision             String?
  notes                String?

  reviewer             User?            @relation("RuleReviewCandidateReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([ruleType])
  @@index([ruleKey])
  @@index([ruleVersion])
  @@index([ruleType, ruleKey, ruleVersion])
  @@index([createdAt])
  @@index([reviewedAt])
}

model DailyMetricSnapshot {
  id             String   @id @default(cuid())
  date           DateTime
  dateKey        String
  metric         String
  dimension      String   @default("GLOBAL")
  dimensionValue String   @default("ALL")
  value          Float?
  numerator      Int      @default(0)
  denominator    Int      @default(0)
  status         String   @default("VALID")
  version        String   @default("V1")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([dateKey, metric, dimension, dimensionValue, version])
  @@index([date])
  @@index([dateKey])
  @@index([metric])
  @@index([dimension, dimensionValue])
  @@index([metric, dimension, date])
  @@index([version])
  @@index([createdAt])
}
