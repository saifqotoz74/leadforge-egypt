  note           String?
  useful         Boolean           @default(true)
  reason         FeedbackReason?
  comment        String?
  confidence     String            @default("MEDIUM")
  flags          String[]          @default([])
  metadata       Json?
  idempotencyKey String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt

  lead           Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim          LeadClaim?        @relation(fields: [claimId], references: [id], onDelete: SetNull)
  engagement     LeadEngagement?   @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([leadId])
  @@index([userId])
  @@index([developerId])
  @@index([claimId])
  @@index([engagementId])
  @@index([category])
  @@index([reasonCode])
  @@index([useful])
  @@index([reason])
  @@index([createdAt])
}

model LeadStatusHistory {
  id                String          @id @default(cuid())
  claimId           String
  engagementId      String?
  leadId            String
  userId            String
  developerId       String?
  previousStatus    String?
  newStatus         String
  reasonCode        String?
  note              String?
  notes             String?
  metadata          Json?
  actorType         String          @default("DEVELOPER")
  actorId           String?
  isAdminCorrection Boolean         @default(false)
  idempotencyKey    String?
  createdAt         DateTime        @default(now())

  claim             LeadClaim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  engagement        LeadEngagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  lead              Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([claimId])
  @@index([engagementId])
  @@index([leadId])
  @@index([userId])
  @@index([developerId])
  @@index([createdAt])
  @@index([engagementId, createdAt])
}

model ContactAttempt {
  id             String               @id @default(cuid())
  engagementId   String
  leadId         String
  developerId    String
  claimId        String
  channel        ContactChannel
  result         ContactAttemptResult
  attemptedAt    DateTime             @default(now())
  note           String?
  metadata       Json?
  idempotencyKey String?
  createdAt      DateTime             @default(now())

  engagement     LeadEngagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  lead           Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  developer      User                 @relation(fields: [developerId], references: [id], onDelete: Cascade)
  claim          LeadClaim            @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([developerId, idempotencyKey])
  @@index([engagementId])
  @@index([leadId])
  @@index([developerId])
  @@index([claimId])
  @@index([channel])
  @@index([result])
  @@index([attemptedAt])
  @@index([engagementId, attemptedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model Payment {
  id             String   @id @default(cuid())
  userId         String
  planId         String
