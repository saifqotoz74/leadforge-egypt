# ==============================================================================
# LEADFORGE EGYPT — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production.example)
# ==============================================================================
# Use this template to set Environment Variables in Vercel Project Settings.
# Replace placeholder values with your real production secrets.

# ------------------------------------------------------------------------------
# 1. Application
# ------------------------------------------------------------------------------
NODE_ENV="production"
APP_ENV="production"
APP_URL="https://app.leadforge.eg"
NEXT_PUBLIC_APP_URL="https://app.leadforge.eg"
ALLOWED_ORIGINS="https://app.leadforge.eg"
DEBUG="false"
ALLOW_PRODUCTION_SEED="false"
APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 2. Database (Supabase Managed PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Connect via Transaction Connection Pooler (Port 6543)
DATABASE_URL="postgresql://postgres.bfjelvvttapeleomshor:[YOUR_SUPABASE_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct connection for Prisma Migrations (Port 5432 - IPv4 Compatible)
DIRECT_URL="postgresql://postgres.bfjelvvttapeleomshor:[YOUR_SUPABASE_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

USE_EXTERNAL_PG="true"
DB_POOL_MAX="15"
DB_CONNECT_TIMEOUT_MS="5000"

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32 (Must be >= 32 characters, high entropy)
AUTH_SECRET="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_RANDOM_32_CHAR_STRING_FOR_AUTH"
CRON_SECRET="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_RANDOM_32_CHAR_STRING_FOR_CRON"
SESSION_TTL_SECONDS="604800"

# ------------------------------------------------------------------------------
# 4. Payment Gateway (Paymob Live)
# ------------------------------------------------------------------------------
PAYMENT_ENABLED="true"
PAYMENT_MODE="LIVE"
PAYMENT_PROVIDER_NAME="PAYMOB"
PAYMENT_PUBLIC_KEY="egy_pk_live_your_paymob_public_key"
PAYMENT_SECRET_KEY="egy_sk_live_your_paymob_secret_key"
PAYMENT_WEBHOOK_SECRET="your_paymob_hmac_webhook_secret"

# ------------------------------------------------------------------------------
# 5. Transactional Email & Notifications (Resend API)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="API"
# When starting, Resend allows sending from onboarding@resend.dev to your account email,
# or from your verified custom domain (e.g. notifications@leadforge.eg) once verified in Resend.
EMAIL_FROM="LeadForge Egypt <onboarding@resend.dev>"
EMAIL_API_KEY="re_your_resend_api_key_here"

# ------------------------------------------------------------------------------
# 6. Storage (Disabled by default, or Supabase S3)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="DISABLED"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# 7. Lead Ingestion & Automated Collectors
# ------------------------------------------------------------------------------
COLLECTORS_ENABLED="true"
COLLECTOR_ALLOWED_SOURCES="manual,csv,google-business,directory,website,open-data"
COLLECTOR_MAX_RECORDS_PER_RUN="250"
GOOGLE_PLACES_API_KEY="AIzaSy_your_google_places_api_key_here"

# ------------------------------------------------------------------------------
# 8. Observability & Alerting
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
MONITORING_ENABLED="true"
ALERT_WEBHOOK_URL=""
